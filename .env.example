# Copie ce fichier en .env et remplis les valeurs (ne JAMAIS committer .env).

# Topic ntfy secret (celui auquel ton téléphone est abonné). Requis pour notifier.
# NE PAS mettre le vrai topic ici (repo public) — il vit dans les GitHub Secrets.
NTFY_TOPIC=mon-topic-ntfy-secret

# Serveur ntfy (optionnel, défaut https://ntfy.sh)
# NTFY_SERVER=https://ntfy.sh

# Cookie de session Jinka (optionnel). Format "name=value; name2=value2"
# ou JSON [{"name":...,"value":...,"domain":".jinka.fr"}]
# JINKA_COOKIE=

# Debug : afficher le navigateur (optionnel)
# SCRAPER_HEADLESS=false
